// What the platform's egress policy gate gives these policies.
//
// The principal is the person the session acts for: their attributes are set
// by an org owner on the member, and their company is an entity the booking
// connector supplies. The resource is the request, mapped by routes.yaml.
//
// Validate locally with the Cedar CLI:
//   cargo install cedar-policy-cli --locked
//   cat policies/*.cedar > /tmp/policyset.cedar
//   cedar validate --schema policies/schema.cedarschema --policies /tmp/policyset.cedar

entity Company {
  // The least seniority that may fly business class on the company's account.
  business_min_level: Long,
  // The most one booking on the company's account may cost, below that
  // seniority and at or above it.
  booking_limit_cents?: Long,
  senior_booking_limit_cents?: Long,
};

entity Person {
  level?: Long,
  company?: Company,
};

entity Search;

// The flight the agent asks the provider to quote.
entity Quote {
  cabin?: String,
};

entity Booking {
  offer_id: String,
  purpose: String,
  payer: String,
  // From the provider-signed quote.
  kind?: String,
  name?: String,
  city?: String,
  flight?: String,
  from?: String,
  to?: String,
  depart?: String,
  check_in?: String,
  check_out?: String,
  nights?: Long,
  cabin?: String,
  block_minutes?: Long,
  total_cents?: Long,
};

// A booking the agent asks the provider to cancel, by its confirmation.
entity Cancellation {
  confirmation: String,
};

// The trip the agent proposes, as its Person Server would see it.
entity TripProposal {
  description?: String,
};

// The agent reporting the trip booked, which the traveller accepts.
entity TripCompletion {
  summary?: String,
};

// Jev's answers to a route's questions, each a percentage (routes.yaml `judge`).
// A question Jev could not answer is absent.
type BookingJudgement = { requested?: Long, personal?: Long };
type MissionJudgement = { requested?: Long };

// The session's AAuth mission, when it has one: what the person approved.
type Mission = { s256: String, resources: Set<String> };

action "booking.search" appliesTo { principal: [Person], resource: [Search], context: {} };
action "booking.quote" appliesTo { principal: [Person], resource: [Quote], context: {} };
action "booking.reserve" appliesTo { principal: [Person], resource: [Booking], context: { mission?: Mission, judgement?: BookingJudgement } };
action "booking.cancel" appliesTo { principal: [Person], resource: [Cancellation], context: { mission?: Mission } };
action "mission.propose" appliesTo { principal: [Person], resource: [TripProposal], context: { judgement?: MissionJudgement } };
action "mission.complete" appliesTo { principal: [Person], resource: [TripCompletion], context: { mission?: Mission } };
